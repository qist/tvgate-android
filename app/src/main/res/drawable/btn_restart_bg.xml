<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态（遥控器选中） -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#332D9CDB" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/splash_logo_color" />
        </shape>
    </item>
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#222D9CDB" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/splash_logo_color" />
        </shape>
    </item>
    <!-- 正常状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D2D9CDB" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#332D9CDB" />
        </shape>
    </item>
</selector>
