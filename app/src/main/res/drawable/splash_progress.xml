<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景圆环（浅色） -->
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.5"
            android:thicknessRatio="10"
            android:useLevel="false">
            <solid android:color="#1A2D9CDB" />
        </shape>
    </item>
    <!-- 前景圆环（品牌色，旋转动画） -->
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.5"
            android:thicknessRatio="10"
            android:useLevel="false">
            <solid android:color="@color/splash_progress_color" />
        </shape>
    </item>
</layer-list>
